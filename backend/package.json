{
  "name": "citycare-unified-backend",
  "version": "1.0.0",
  "description": "Unified Node.js / Express & MongoDB Backend API Server for CityCare CDO (Web Admin Portal & Resident Mobile App)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seeder.js",
    "seed:community-content:examples": "node scripts/seedCommunityContentExamples.js",
    "seed:schedules:sample": "node scripts/seedSampleCollectionSchedules.js",
    "test:coordinates": "node --test test/coordinates.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "citycare",
    "jwt",
    "waste-management"
  ],
  "author": "CityCare Development Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.2.0",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.2",
    "validator": "^13.15.35",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
